# ============================================================
# Variables de `docker compose` para levantar Trazo completo.
#
#   cp .env.docker.example .env     (y edita los valores)
#   docker compose up -d --build
#
# Este archivo es la PLANTILLA y sí se versiona; el `.env` que generes NO (está en
# .gitignore). No pongas secretos reales aquí.
#
# Nota: este `.env` es el de `docker compose` y es DISTINTO de `backend/.env`, que es el que
# usan el backend y las pruebas cuando corres en el host sin contenedores.
# ============================================================

# --- Base de datos -------------------------------------------------------------
POSTGRES_USER=trazo
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=trazo

# --- Secreto de sesión (OBLIGATORIO) --------------------------------------------
# Sin esto `docker compose up` aborta a propósito: un secreto por defecto es un secreto
# público. Genera el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Puerto público -------------------------------------------------------------
# Puerto del HOST por el que se entra a la aplicación (el backend no se expone: solo habla
# con el frontend por la red interna de Docker).
PUERTO_PUBLICO=3000

# --- Semilla del primer administrador -------------------------------------------
# Solo se usan si ejecutas la semilla A MANO (no ocurre al levantar):
#   docker compose run --rm backend npx prisma db seed --schema backend/prisma/schema.prisma
# El usuario nace con `debe_cambiar_password=true`: la contraseña definitiva se fija en el
# primer inicio de sesión (FR-005).
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=
