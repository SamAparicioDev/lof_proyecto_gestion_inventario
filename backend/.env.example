# ============================================================
# Variables de entorno del backend Trazo
# Copia este archivo a backend/.env y ajusta los valores.
# NUNCA subas backend/.env al repositorio (está en .gitignore).
# ============================================================

# Conexión a PostgreSQL de desarrollo (docker compose up -d db)
DATABASE_URL="postgresql://trazo:trazo@localhost:5432/trazo?schema=public"

# BD exclusiva de pruebas de integración (creada por docker/init-test-db.sql).
# Las suites de backend/test/integracion la TRUNCAN entre pruebas — jamás apuntes aquí datos reales.
DATABASE_URL_TEST="postgresql://trazo:trazo@localhost:5432/trazo_test?schema=public"

# BD exclusiva de pruebas E2E (Playwright, T066). Su global-setup hace
# "prisma migrate reset --force" (BORRA Y RECREA el esquema) — debe ser una tercera base,
# distinta de "trazo" y "trazo_test".
DATABASE_URL_E2E="postgresql://trazo:trazo@localhost:5432/trazo_e2e?schema=public"

# Secreto para firmar los JWT de sesión (cookie httpOnly).
# Genera uno propio, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-este-secreto"

# Puerto de la API (el frontend hace proxy de /api/* hacia aquí — ver frontend/next.config.ts)
PORT=4000

# Usuario Administrador semilla (prisma db seed). Entra con debe_cambiar_password=true,
# así que la contraseña definitiva se define en el primer login (FR-005, research R12).
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="cambia-esta-clave"
# Opcionales — si se omiten, el seed usa "Administrador" y "<login>@trazo.local".
SEED_ADMIN_NOMBRE="Administrador"
SEED_ADMIN_EMAIL="admin@trazo.local"

# Contraseña de los usuarios de demostración gerente.demo / operario.demo
# (solo se crean con `npm run seed:demo` — jamás usar en producción).
SEED_DEMO_PASSWORD="demo-trazo"

# ---------------------------------------------------------------------------
# Super administrador — respaldo del sistema (US30, FR-129)
# ---------------------------------------------------------------------------
# El backend crea este usuario AL ARRANCAR si no existe, y lo engancha al rol de respaldo
# (`roles.es_super_admin`, sembrado por la migración `20260819090000_super_administrador`).
#
# Su razón de ser: si alguien deja el sistema sin nadie que pueda administrar permisos, este
# usuario sigue pudiendo todo — su autorización no se resuelve contra `roles_permisos`.
#
# Reglas:
#   - Si el usuario YA existe, el arranque no lo toca (ni contraseña, ni rol, ni estado).
#   - Si estas variables faltan, la aplicación arranca igual y lo deja anotado en el log.
#   - El rol NO se puede asignar desde la aplicación: la única otra vía es
#     `UPDATE usuarios SET rol_id = (SELECT id FROM roles WHERE es_super_admin) WHERE login = '...'`
#
# En producción se definen en el panel de Railway, NUNCA en el repositorio.
SUPERADMIN_LOGIN="superadmin"
SUPERADMIN_EMAIL="superadmin@lof.local"
SUPERADMIN_NOMBRE="Super administrador"
SUPERADMIN_PASSWORD="cambia-esta-clave"

# ---------------------------------------------------------------------------
# Asistente de consultas — Google AI Studio (US33, FR-133/FR-136)
# ---------------------------------------------------------------------------
# Clave de la API de Google AI Studio (https://aistudio.google.com/apikey).
#
# SIN ella el asistente queda apagado y lo dice en pantalla; el resto de la aplicación funciona con
# normalidad — es la única pieza que depende de un servicio externo y no puede arrastrar al resto.
#
# En producción se define en el panel de Railway, NUNCA en el repositorio: este archivo es el
# EJEMPLO (sí versionado); el valor real va en `backend/.env`, que está en .gitignore.
#
# También se aceptan `GEMINI_API_KEY` y `GOOGLE_AI_API_KEY`, que son los nombres que documenta
# Google, por si alguien llega con ellos.
API_KEY_GOOGLE_AI_STUDIO=""

# Modelos a usar, separados por coma y probados EN ORDEN. OPCIONAL: por defecto
# `gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest`.
#
# Que sean varios no es redundancia: cuando Google devuelve "503 high demand" el problema es del
# MODELO, no del servicio, así que insistirle al saturado es esperar y preguntarle al siguiente es
# hablar con uno libre.
#
# El primero está FIJADO a propósito y no es un alias `-latest`: `-latest` apunta al más nuevo, que
# es el más congestionado y a veces el que tiene cuota cero en el plan gratuito. Medido el
# 2026-08-21: `gemini-3.6-flash` 1,6 s; `gemini-flash-latest` 6,4 s cuando no fallaba.
#
# Con facturación activada, poner `gemini-pro-latest` de primero encadena mejor las preguntas de
# varios pasos. En el plan gratuito la cuota de los Pro es CERO y fallan siempre.
AI_MODEL=""
