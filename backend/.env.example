# ============================================================
# Variables de entorno del backend Trazo
# Copia este archivo a backend/.env y ajusta los valores.
# NUNCA subas backend/.env al repositorio (está en .gitignore).
# ============================================================

# Conexión a PostgreSQL de desarrollo (docker compose up -d db)
DATABASE_URL="postgresql://trazo:trazo@localhost:5432/trazo?schema=public"

# BD exclusiva de pruebas de integración (creada por docker/init-test-db.sql).
# Las suites de backend/test/integracion la TRUNCAN entre pruebas — jamás apuntes aquí datos reales.
DATABASE_URL_TEST="postgresql://trazo:trazo@localhost:5432/trazo_test?schema=public"

# BD exclusiva de pruebas E2E (Playwright, T066). Su global-setup hace
# "prisma migrate reset --force" (BORRA Y RECREA el esquema) — debe ser una tercera base,
# distinta de "trazo" y "trazo_test".
DATABASE_URL_E2E="postgresql://trazo:trazo@localhost:5432/trazo_e2e?schema=public"

# Secreto para firmar los JWT de sesión (cookie httpOnly).
# Genera uno propio, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-este-secreto"

# Puerto de la API (el frontend hace proxy de /api/* hacia aquí — ver frontend/next.config.ts)
PORT=4000

# Usuario Administrador semilla (prisma db seed). Entra con debe_cambiar_password=true,
# así que la contraseña definitiva se define en el primer login (FR-005, research R12).
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="cambia-esta-clave"
# Opcionales — si se omiten, el seed usa "Administrador" y "<login>@trazo.local".
SEED_ADMIN_NOMBRE="Administrador"
SEED_ADMIN_EMAIL="admin@trazo.local"

# Contraseña de los usuarios de demostración gerente.demo / operario.demo
# (solo se crean con `npm run seed:demo` — jamás usar en producción).
SEED_DEMO_PASSWORD="demo-trazo"
